{
  "name": "@megaai/node-agent",
  "version": "0.1.0",
  "description": "The agent that runs on your laptop: joins the mesh, watches CPU/RAM/heat/battery, backs off while you work, drives the coding CLIs and survives a reboot",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": { "build": "tsc -b" },
  "dependencies": {
    "@megaai/coders": "0.1.0",
    "@megaai/mesh": "0.1.0",
    "@megaai/types": "0.1.0",
    "@megaai/utils": "0.1.0"
  },
  "license": "MIT"
}
