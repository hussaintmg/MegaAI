{
  "name": "@megaai/mesh",
  "version": "0.1.0",
  "description": "The node mesh: laptop, phone and cloud share one durable task queue with leases, capability routing and live events",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mongo": {
      "types": "./dist/mongo.d.ts",
      "import": "./dist/mongo.js"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "import": "./dist/file.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@megaai/types": "0.1.0",
    "@megaai/utils": "0.1.0"
  },
  "license": "MIT"
}
